<Project Sdk="Microsoft.NET.Sdk">

  <!-- Classic Windows launcher, stage 2: launcher\GTANSubprocess.exe. Tiny host that loads
       launcher\GTANetwork.dll (GTANSubprocess project) and runs its ISubprocessBehaviour. -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>GTANSubprocess</AssemblyName>
    <RootNamespace>GTANSubprocess</RootNamespace>
    <AssemblyTitle>GTA Network subprocess</AssemblyTitle>
    <ApplicationIcon>logo64.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="$(NetFrameworkReferenceAssembliesVersion)" PrivateAssets="all" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data" />
    <Reference Include="System.Deployment" />
    <Reference Include="System.Runtime.Remoting" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\GTANetworkShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="logo32.ico;logo64.ico" />
  </ItemGroup>

</Project>
