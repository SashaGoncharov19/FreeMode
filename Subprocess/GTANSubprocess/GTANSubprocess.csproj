<Project Sdk="Microsoft.NET.Sdk">

  <!-- Classic Windows launcher, stage 3: launcher\GTANetwork.dll. Loaded by GTANSubprocess.exe; checks
       dependencies/updates, patches game settings, starts GTA V and injects ScriptHookV + SHVDN. -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>GTANetwork</AssemblyName>
    <RootNamespace>GTANetwork</RootNamespace>
    <AssemblyTitle>GTA Network launcher behaviour</AssemblyTitle>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="$(NetFrameworkReferenceAssembliesVersion)" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />
    <PackageReference Include="Ionic.Zip" Version="1.9.1.8" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\GTANetworkShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\splash.png" LogicalName="splash.png" />
    <None Remove="app.config" />
  </ItemGroup>

</Project>
