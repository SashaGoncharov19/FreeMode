<Project Sdk="Microsoft.NET.Sdk">

  <!-- Classic Windows launcher, stage 1: GTANLauncher.exe (the desktop shortcut). Registers the install
       directory in the registry, self-updates the launcher\ folder and starts launcher\GTANSubprocess.exe. -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>GTANLauncher</AssemblyName>
    <RootNamespace>GTANLauncher</RootNamespace>
    <AssemblyTitle>GTA Network launcher</AssemblyTitle>
    <ApplicationIcon>logo64.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="$(NetFrameworkReferenceAssembliesVersion)" PrivateAssets="all" />
    <PackageReference Include="Ionic.Zip" Version="1.9.1.8" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data" />
    <Reference Include="System.Deployment" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\splash.png" LogicalName="splash.png" />
    <None Remove="logo32.ico;logo64.ico" />
  </ItemGroup>

</Project>
