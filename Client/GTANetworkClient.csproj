<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The in-game client. It is loaded inside GTA5.exe by ScriptHookVDotNet (which hosts the
    .NET Framework CLR), so it must stay a .NET Framework assembly. It compiles on any OS thanks to
    Microsoft.NETFramework.ReferenceAssemblies; native/third-party DLLs that have no NuGet package
    (or whose NuGet version differs from the tested binary) are referenced from ../libs.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>GTANetwork</AssemblyName>
    <RootNamespace>GTANetwork</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>GTA Network client</AssemblyTitle>
    <Description>GTA Network multiplayer client (runs inside GTA5.exe via ScriptHookVDotNet).</Description>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="$(NetFrameworkReferenceAssembliesVersion)" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />
    <PackageReference Include="protobuf-net" Version="$(ProtobufNetVersion)" />
    <PackageReference Include="EasyHook" Version="2.7.6035" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Remoting" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Web" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- Binary dependencies without a matching NuGet package (ClearScript 5.4.9 with its native V8 bridge,
       custom Lidgren fork, CEF 3.2987 (Chromium 57) CefGlue build, the exact SharpDX mix that the DirectX hook was tested with, NAudio). -->
  <ItemGroup>
    <!-- The managed ClearScript.dll must be the exact build that matches libs/ClearScriptV8-64.dll (5.4.9);
         the ClearScript.V8 NuGet package ships 5.4.6 and its assembly version does not match the native bridge,
         which makes V8ScriptEngine throw FileLoadException at runtime. -->
    <Reference Include="ClearScript"><HintPath>$(GtanLibsDir)ClearScript.dll</HintPath></Reference>
    <Reference Include="Lidgren.Network"><HintPath>$(GtanLibsDir)Lidgren.Network.dll</HintPath></Reference>
    <Reference Include="NAudio"><HintPath>$(GtanLibsDir)NAudio.dll</HintPath></Reference>
    <Reference Include="SharpDX"><HintPath>$(GtanLibsDir)SharpDX.dll</HintPath></Reference>
    <Reference Include="SharpDX.D3DCompiler"><HintPath>$(GtanLibsDir)SharpDX.D3DCompiler.dll</HintPath></Reference>
    <Reference Include="SharpDX.Desktop"><HintPath>$(GtanLibsDir)SharpDX.Desktop.dll</HintPath></Reference>
    <Reference Include="SharpDX.Direct3D11"><HintPath>$(GtanLibsDir)SharpDX.Direct3D11.dll</HintPath></Reference>
    <Reference Include="SharpDX.Direct3D11.Effects"><HintPath>$(GtanLibsDir)SharpDX.Direct3D11.Effects.dll</HintPath></Reference>
    <Reference Include="SharpDX.DXGI"><HintPath>$(GtanLibsDir)SharpDX.DXGI.dll</HintPath></Reference>
    <Reference Include="SharpDX.Mathematics"><HintPath>$(GtanLibsDir)SharpDX.Mathematics.dll</HintPath></Reference>
    <Reference Include="Xilium.CefGlue"><HintPath>$(GtanLibsDir)Xilium.CefGlue.dll</HintPath></Reference>
  </ItemGroup>

  <!-- ScriptHookVDotNet: the real C++/CLI build when present, otherwise the managed reference stub. -->
  <ItemGroup Condition="'$(UseRealShvdn)' == 'true'">
    <Reference Include="ScriptHookVDotNet">
      <HintPath>$(ShvdnRealAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseRealShvdn)' != 'true'">
    <ProjectReference Include="..\Shv.NET\ref\ScriptHookVDotNet.Ref.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\GTANetworkShared.csproj" />
    <ProjectReference Include="..\NativeUI\NativeUI.csproj" />
  </ItemGroup>

  <!-- Legacy sources kept in the tree but never part of the build (superseded by GUI/, Streamer/, Sync/). -->
  <ItemGroup>
    <Compile Remove="Chat.cs" />
    <Compile Remove="ClassicChat.cs" />
    <Compile Remove="GUI\DirectXHook\Hook\DXHookD3D10.cs" />
    <Compile Remove="GUI\DirectXHook\Hook\DXHookD3D10_1.cs" />
    <Compile Remove="Main\Math.cs" />
    <Compile Remove="Misc\Program.cs" />
    <Compile Remove="Networking\PedThread.cs" />
    <Compile Remove="Networking\StreamedItems.cs" />
    <Compile Remove="Networking\Streamer.cs" />
    <Compile Remove="Networking\SyncEventWatcher.cs" />
    <Compile Remove="Networking\SyncPed.cs" />
    <Compile Remove="Networking\SyncSender.cs" />
    <Compile Remove="Networking\UnoccupiedVehicleSync.cs" />
    <Compile Remove="Networking\WeaponManager.cs" />
    <Compile Remove="Util\DebugWindow.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="soundlist.txt" />
    <EmbeddedResource Include="natives.txt" />
  </ItemGroup>

</Project>
