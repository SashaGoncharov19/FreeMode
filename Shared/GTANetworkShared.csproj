<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48: consumed in-game (ScriptHookVDotNet hosts .NET Framework) and by the classic Windows launcher.
         netstandard2.0: consumed by the .NET 8 server and the cross-platform launcher. -->
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <AssemblyName>GTANetworkShared</AssemblyName>
    <RootNamespace>GTANetworkShared</RootNamespace>
    <AssemblyTitle>GTANetworkShared</AssemblyTitle>
    <Description>Types shared between the GTA Network client and server (packets, math, settings).</Description>
    <!-- Cef/CefFrameBuffer.cs reads and writes the shared-memory frames through raw pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />
    <PackageReference Include="protobuf-net" Version="$(ProtobufNetVersion)" />
    <!-- X25519 + HKDF for the session handshake and AES-GCM for clients on .NET Framework (the server and the bot use System.Security.Cryptography.AesGcm). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <!-- Opus in pure C# (T-015 voice): the bot encodes test audio with it; the in-game client will encode and decode with it (T-016). -->
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lidgren adapter of the session cipher: compiled into the server, the client and the bot (they reference Lidgren), not here. -->
    <Compile Remove="Crypto\NetSessionEncryption.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="$(NetFrameworkReferenceAssembliesVersion)" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Key.pfx" />
  </ItemGroup>

</Project>
