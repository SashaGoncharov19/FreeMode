<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The master list (T-011): servers announce themselves every minute (POST /addserver, the path the 2016 server used), the
    master pings the announced UDP port with a Lidgren discovery request before listing, and the launcher and the in-game menu
    read GET /servers (the 2016 shape, a list of "host:port"), GET /servers/full (name, players, gamemode, map, version, the
    server's public key for pinning, verified), GET /verified, GET /stats and GET /welcome.json. SQLite in MASTER_DATA (./data).
    Runs anywhere .NET 10 runs; the Dockerfile next to it builds an image.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>GTANetwork.Master</AssemblyName>
    <RootNamespace>GTANetwork.Master</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RollForward>LatestMajor</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <Reference Include="Lidgren.Network">
      <HintPath>$(GtanLibsDir)Lidgren.Network.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\..\Shared\GTANetworkShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="tests\**" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
