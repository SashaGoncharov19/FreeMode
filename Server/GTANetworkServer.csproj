<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dedicated server. Runs natively on Linux, Windows and macOS on .NET 8.
    Resource scripts (C# / VB) are compiled at runtime with Roslyn, so the server must be published
    framework-dependent and NOT as a single file (Roslyn needs the reference assemblies on disk).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>GTANetworkServer</AssemblyName>
    <RootNamespace>GTANetworkServer</RootNamespace>
    <AssemblyTitle>GTA Network server</AssemblyTitle>
    <Description>GTA Network dedicated multiplayer server.</Description>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <UseAppHost>true</UseAppHost>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />
    <PackageReference Include="protobuf-net" Version="$(ProtobufNetVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="$(RoslynVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Custom Lidgren fork (adds MaxPlayers etc.); .NET Framework build, loads fine on .NET 8. -->
    <Reference Include="Lidgren.Network">
      <HintPath>$(GtanLibsDir)Lidgren.Network.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\Shared\GTANetworkShared.csproj" />
  </ItemGroup>

  <!-- Default configuration and the example resource are copied next to the binary so "dotnet run" just works. -->
  <ItemGroup>
    <Content Include="settings.xml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="resources\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Resource scripts are compiled by the server at runtime (Roslyn), never into this assembly. -->
    <Compile Remove="resources\**" />
  </ItemGroup>

</Project>
