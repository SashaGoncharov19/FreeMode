<?xml version="1.0" encoding="utf-8"?>
<config>
  <servername>GTA Network development server</servername>
  <serverport>4499</serverport>
  <maxplayers>32</maxplayers>
  <minclientversion>0.0.0.0</minclientversion>
  <minclientversion_auto_update>false</minclientversion_auto_update>
  <!-- The public master server (master.gtanet.work) is gone; keep announcing off unless you host your own. -->
  <announce>false</announce>
  <!-- The master list to announce to (Tools/GTANetwork.Master, T-011), e.g. https://master.example.org; empty = none. -->
  <master></master>
  <!-- Threads that encrypt and enqueue the per-player copies of every message off the tick thread (T-023); 0 = automatic (cores minus two, 1..4). -->
  <relaythreads>0</relaythreads>
  <upnp>false</upnp>
  <announce_lan>true</announce_lan>
  <password></password>
  <acl_enabled>false</acl_enabled>
  <log>false</log>
  <loglevel>2</loglevel>
  <!-- Serve the resources' <file>s (CEF pages, images, sounds) over HTTP (TCP, same port number) instead of streaming
       them over UDP. The map and the client scripts always travel over UDP. -->
  <httpserver>true</httpserver>
  <local_address>0.0.0.0</local_address>
  <fqdn></fqdn>
  <conntimeout>true</conntimeout>
  <allowcefdevtool>false</allowcefdevtool>
  <!-- Every client does the X25519 handshake and talks AES-256-GCM (T-009); false lets clients from before 0.2.0-alpha.6 join in plaintext. -->
  <RequireEncryption>true</RequireEncryption>
  <!-- Resources to start, in order. Each one lives in resources/<name>/meta.xml -->
  <!-- Accounts with a login form (resources/auth): uncomment to require /register and /login before playing. -->
  <!-- <resource src="auth" /> -->
  <resource src="freeroam" />
  <resource src="tsdemo" />
  <resource src="example" />
</config>
