<Project>
  <!--
    Shared MSBuild settings for every project in the repository.

    Version scheme (kept from the original T4 templates so that the network
    protocol compatibility checks keep working):
        0.1.<days since 2016-01-01>.<UTC minutes since midnight / 2>
    Override from CI or the command line with -p:GtanBuildNumber=N -p:GtanRevision=N.
  -->
  <PropertyGroup>
    <GtanBuildNumber Condition="'$(GtanBuildNumber)' == ''">$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.Subtract($([System.DateTime]::Parse('2016-01-01'))).TotalDays)))))</GtanBuildNumber>
    <GtanRevision Condition="'$(GtanRevision)' == ''">$([System.Convert]::ToInt32($([System.Math]::Floor($([MSBuild]::Divide($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes), 2))))))</GtanRevision>
    <GtanVersion>0.1.$(GtanBuildNumber).$(GtanRevision)</GtanVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Version>$(GtanVersion)</Version>
    <AssemblyVersion>$(GtanVersion)</AssemblyVersion>
    <FileVersion>$(GtanVersion)</FileVersion>
    <InformationalVersion>$(GtanVersion)</InformationalVersion>
    <Company>GTA Network</Company>
    <Product>GTA Network</Product>
    <Copyright>Copyright © GTA Network contributors</Copyright>
    <Authors>GTA Network contributors</Authors>
    <RepositoryUrl>https://github.com/SashaGoncharov19/FreeMode</RepositoryUrl>
    <NeutralLanguage>en</NeutralLanguage>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <!-- The code base is old; keep the build quiet about obsolete-but-working APIs and missing XML docs. -->
    <NoWarn>$(NoWarn);CS1591;CS0618;CS0612;CS0067;CS0169;CS0414;CS0649;CS0168;CS0219;CS0162;CS0108;CS0109;CS0114;CS0628;CS0659;CS0661;CS8981;SYSLIB0014;SYSLIB0021;SYSLIB0011;NU1701;NU1702;NU1603;NU1605;NU1902;NU1903</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!-- Path of the real ScriptHookVDotNet build (C++/CLI, Windows + MSVC only).
       When it is missing (e.g. on Linux) the client stack compiles against the
       managed reference stub in Shv.NET/ref instead. -->
  <PropertyGroup>
    <GtanRepoRoot>$(MSBuildThisFileDirectory)</GtanRepoRoot>
    <GtanLibsDir>$(GtanRepoRoot)libs\</GtanLibsDir>
    <ShvdnRealAssembly>$(GtanRepoRoot)Shv.NET\bin\ScriptHookVDotNet.dll</ShvdnRealAssembly>
    <UseRealShvdn Condition="'$(UseRealShvdn)' == '' and Exists('$(ShvdnRealAssembly)')">true</UseRealShvdn>
    <UseRealShvdn Condition="'$(UseRealShvdn)' == ''">false</UseRealShvdn>
  </PropertyGroup>

  <!-- Package versions used across projects. -->
  <PropertyGroup>
    <NewtonsoftJsonVersion>13.0.4</NewtonsoftJsonVersion>
    <ProtobufNetVersion>2.4.9</ProtobufNetVersion>
    <NetFrameworkReferenceAssembliesVersion>1.0.3</NetFrameworkReferenceAssembliesVersion>
    <RoslynVersion>5.9.0</RoslynVersion>
    <ClearScriptVersion>7.5.1</ClearScriptVersion>
    <CefSharpVersion>151.3.240</CefSharpVersion>
  </PropertyGroup>
</Project>
