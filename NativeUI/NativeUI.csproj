<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>NativeUI</AssemblyName>
    <RootNamespace>NativeUI</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyTitle>NativeUI</AssemblyTitle>
    <Description>Rockstar-style menu library for ScriptHookVDotNet (GTA Network fork).</Description>
    <!-- NativeUI is GPL-3.0 (see LICENSE.md); keep its own version. -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="$(NetFrameworkReferenceAssembliesVersion)" PrivateAssets="all" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- ScriptHookVDotNet: the real C++/CLI build when present, otherwise the managed reference stub. -->
  <ItemGroup Condition="'$(UseRealShvdn)' == 'true'">
    <Reference Include="ScriptHookVDotNet">
      <HintPath>$(ShvdnRealAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseRealShvdn)' != 'true'">
    <ProjectReference Include="..\Shv.NET\ref\ScriptHookVDotNet.Ref.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MenuExample.cs" />
    <None Remove="LICENSE.md;README.md;.gitignore;.gitattributes;NativeUI.sln;MenuExample.csproj" />
  </ItemGroup>

</Project>
